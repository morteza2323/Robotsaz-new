# Replace these before deploying. Keep JWT_SECRET long and random.
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

# Arvan Cloud Object Storage (S3-compatible). Never expose these in the browser.
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
ARVAN_BUCKET=
ARVAN_ENDPOINT=
ARVAN_PUBLIC_BASE_URL=

# Arvan Video Platform (VOD). Never expose this key in the browser.
ARVAN_VOD_API_KEY=
ARVAN_VOD_CHANNEL_NAME=
ARVAN_VOD_SUBDOMAIN=
