ARVAN_SECRET_KEY=
ARVAN_BUCKET=
ARVAN_ENDPOINT=
ARVAN_REGION=
ARVAN_PUBLIC_BASE_URL=

# Arvan Video Platform (VOD). Never expose this key in the browser.
